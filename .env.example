# Copy this file to .env and fill in your values.
# Generate an App Password at: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Password used to encrypt Dime confirmation PDFs (set when you opened the account)
PDF_PASSWORD=your_dime_pdf_password

# Supabase configuration
# URL: Project Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co
# Key: Project Settings → API → service_role key (not the anon key)
SUPABASE_SERVICE_KEY=your_service_role_key_here
# Table name in Supabase (default: trades)
SUPABASE_TABLE=dime-txn
